# Cloud API / Prisma (PostgreSQL) — used by @r2a/database and @r2a/server
# Prerequisite: PostgreSQL reachable (local install, Docker, or hosted e.g. Neon).
# Create DB once if local: createdb r2a_pharmacy_pos  (or via pgAdmin / psql).
#
# Env loading (locked for M2):
# - Single source: copy this file to the **repo root** as `.env` (never commit it).
# - `@r2a/server` loads **only** the repo-root `.env` (not `apps/server/.env`).
# - Prisma CLI also expects env in `packages/database/` — copy/symlink root `.env` there,
#   or run Prisma from a context that inherits root env.
# Neon example shape: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/r2a_pharmacy_pos?schema=public
JWT_SECRET=change-me-in-production
# Short-lived access JWT (SaaS default)
JWT_EXPIRES_IN=15m
# Opaque refresh token TTL (hashed in DB; rotated on use)
REFRESH_TOKEN_EXPIRES_IN=7d
# Dev default 8787 — avoids Windows collisions on :5000 / leftover tsx watches.
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420

# Desktop Vite (@r2a/desktop) — copy to apps/desktop/.env (never commit).
# Points at this Express API (PORT above). Used as import.meta.env.VITE_API_BASE_URL.
# VITE_API_BASE_URL=http://localhost:8787

# Dev seed only (@r2a/database prisma/seed.ts) — not production secrets
# SEED_OWNER_EMAIL=owner@demo.local
# SEED_OWNER_PASSWORD=ChangeMe123!
