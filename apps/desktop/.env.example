# Desktop Vite env (copy to apps/desktop/.env — never commit .env)
# Points at Milestone 2 Express API (repo-root server .env PORT, default 8787)
# Prefer 127.0.0.1 over localhost on Windows (avoids slow IPv6 ::1 attempts).
VITE_API_BASE_URL=http://127.0.0.1:8787

# Batch C auth: login uses POST /api/v1/auth/login against the URL above.
# Seed demo: owner@demo.local / ChangeMe123! (tenant slug demo-pharmacy if needed)
# Tokens: webview localStorage (MVP) — see src/lib/tokenStore.ts
# Batch D: header badge probes GET /api/v1/health; starts as Checking… then Connected/Offline
# Batch E: Tauri opens pos_local.db under app data; Vite browser uses memory/localStorage fallback
# Cache pull (online): GET /api/v1/products + /api/v1/batches → local cache (no M4 flush)
